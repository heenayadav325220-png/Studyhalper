{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile with gamification stats, XP, streak, language and pet details",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user"
        },
        "xp": {
          "type": "integer",
          "description": "Total XP earned"
        },
        "level": {
          "type": "integer",
          "description": "Current student level"
        },
        "streak": {
          "type": "integer",
          "description": "Consecutive study days streak"
        },
        "petLevel": {
          "type": "integer",
          "description": "Current pet companion level"
        },
        "petXp": {
          "type": "integer",
          "description": "Current pet companion XP"
        },
        "petName": {
          "type": "string",
          "description": "Name of the study pet companion"
        },
        "language": {
          "type": "string",
          "description": "UI language preference (en or hi)"
        },
        "lastActive": {
          "type": "string",
          "description": "ISO string of last activity timestamp"
        },
        "lastStreakDate": {
          "type": "string",
          "description": "YYYY-MM-DD local date of last streak continuation"
        },
        "unlockedBadges": {
          "type": "array",
          "description": "Array of unlocked badge IDs",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["uid", "name", "xp", "level", "streak", "petLevel", "petXp", "petName", "language", "lastActive"]
    },
    "chatMessage": {
      "title": "ChatMessage",
      "description": "Real-time group chat messages for study collaboration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID"
        },
        "roomId": {
          "type": "string",
          "description": "Study room identifier"
        },
        "senderId": {
          "type": "string",
          "description": "Sender user ID"
        },
        "senderName": {
          "type": "string",
          "description": "Sender display name"
        },
        "text": {
          "type": "string",
          "description": "Content of the message"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO string of message timestamp"
        }
      },
      "required": ["id", "roomId", "senderId", "senderName", "text", "timestamp"]
    },
    "whiteboardElement": {
      "title": "WhiteboardElement",
      "description": "A single drawing or text element on the real-time shared whiteboard",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique element ID"
        },
        "roomId": {
          "type": "string",
          "description": "Study room identifier"
        },
        "type": {
          "type": "string",
          "description": "Type of element (path, rect, circle, text)"
        },
        "color": {
          "type": "string",
          "description": "Hex color of the element"
        },
        "thickness": {
          "type": "integer",
          "description": "Line stroke width"
        },
        "points": {
          "type": "string",
          "description": "JSON serialized coordinates list for path or geometry details"
        },
        "text": {
          "type": "string",
          "description": "Text value for text elements"
        },
        "senderId": {
          "type": "string",
          "description": "Creator user ID"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO string of element creation"
        }
      },
      "required": ["id", "roomId", "type", "color", "thickness", "points", "senderId", "timestamp"]
    },
    "mockExam": {
      "title": "MockExam",
      "description": "AI-generated exam structure and user submissions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique exam ID"
        },
        "userId": {
          "type": "string",
          "description": "ID of user taking the exam"
        },
        "subject": {
          "type": "string",
          "description": "Exam subject"
        },
        "topic": {
          "type": "string",
          "description": "Exam topic"
        },
        "questionsJson": {
          "type": "string",
          "description": "JSON serialized list of questions and options"
        },
        "submittedAnswersJson": {
          "type": "string",
          "description": "JSON serialized list of submitted answers"
        },
        "score": {
          "type": "integer",
          "description": "Calculated score (0 to 100)"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether exam is completed and graded"
        },
        "feedback": {
          "type": "string",
          "description": "AI structured study feedback"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO string of exam timestamp"
        }
      },
      "required": ["id", "userId", "subject", "topic", "questionsJson", "submittedAnswersJson", "score", "completed", "feedback", "timestamp"]
    },
    "studyDocument": {
      "title": "StudyDocument",
      "description": "Study notes and summaries with AI analysis and visual explanation details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique document ID"
        },
        "ownerId": {
          "type": "string",
          "description": "ID of document owner"
        },
        "title": {
          "type": "string",
          "description": "Title of the document"
        },
        "content": {
          "type": "string",
          "description": "Rich text study notes or raw transcript"
        },
        "summary": {
          "type": "string",
          "description": "AI generated concise summary"
        },
        "tagsJson": {
          "type": "string",
          "description": "JSON serialized tag array"
        },
        "isShared": {
          "type": "boolean",
          "description": "Whether notes are shared publicly/group"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO string of document creation"
        }
      },
      "required": ["id", "ownerId", "title", "content", "summary", "tagsJson", "isShared", "timestamp"]
    },
    "mistake": {
      "title": "MistakeItem",
      "description": "A single missed question item tracked in the student's mistake book",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "answer": { "type": "integer" },
        "explanation": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "userAnswer": { "type": "integer" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "question", "options", "answer", "explanation", "subject", "topic", "userAnswer", "timestamp"]
    },
    "spaced_revision": {
      "title": "RevisionItem",
      "description": "A scheduled spaced-repetition study revision task for a topic",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "lastStudied": { "type": "string" },
        "nextDue": { "type": "string" },
        "intervalDays": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "completed"] }
      },
      "required": ["id", "subject", "topic", "priority", "lastStudied", "nextDue", "intervalDays", "status"]
    },
    "learning_state": {
      "title": "LearningState",
      "description": "Aggregated list of completed and weak topics for user personalization",
      "type": "object",
      "properties": {
        "completedTopics": { "type": "array", "items": { "type": "string" } },
        "weakTopics": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["completedTopics", "weakTopics"]
    },
    "learning_progress": {
      "title": "LearningProgress",
      "description": "Real-time accuracy and mastery tracking progress metrics per topic",
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "attempts": { "type": "integer" },
        "correct": { "type": "integer" },
        "incorrect": { "type": "integer" },
        "accuracy": { "type": "integer" },
        "lastStudied": { "type": "string" },
        "mastery": { "type": "integer" },
        "updatedAt": { "type": "string" }
      },
      "required": ["subject", "topic", "attempts", "correct", "incorrect", "accuracy", "lastStudied", "mastery", "updatedAt"]
    },
    "quotaUsage": {
      "title": "QuotaUsage",
      "description": "Daily AI features usage logs for rate-limiting",
      "type": "object",
      "properties": {
        "aiTutor": { "type": "integer" },
        "notes": { "type": "integer" },
        "quiz": { "type": "integer" },
        "mockExam": { "type": "integer" },
        "questionPaper": { "type": "integer" },
        "ocr": { "type": "integer" },
        "mindmap": { "type": "integer" },
        "explainTopic": { "type": "integer" },
        "aiEditor": { "type": "integer" },
        "other": { "type": "integer" }
      }
    }
  },
  "firestore": {
    "usage/{userId}/daily/{date}": {
      "schema": "quotaUsage",
      "description": "Daily AI request usage counts for abuse prevention"
    },
    "users/{userId}": {
      "schema": "user",
      "description": "Collection storing user profiles and gamification stats"
    },
    "users/{userId}/mistakes/{mistakeId}": {
      "schema": "mistake",
      "description": "Nest collection of logged quiz/mock exam mistakes"
    },
    "users/{userId}/spaced_revisions/{revisionId}": {
      "schema": "spaced_revision",
      "description": "Nested spaced-repetition scheduled study tasks"
    },
    "users/{userId}/learning_state/{stateId}": {
      "schema": "learning_state",
      "description": "Aggregated student status profile"
    },
    "users/{userId}/learning_progress/{progressId}": {
      "schema": "learning_progress",
      "description": "Nested topic performance metrics"
    },
    "rooms/{roomId}/chats/{chatId}": {
      "schema": "chatMessage",
      "description": "Real-time group chat messages nested under collaborative rooms"
    },
    "rooms/{roomId}/whiteboard/{elementId}": {
      "schema": "whiteboardElement",
      "description": "Real-time vector whiteboard elements for study drawing"
    },
    "exams/{examId}": {
      "schema": "mockExam",
      "description": "AI-generated exam evaluations and responses"
    },
    "documents/{docId}": {
      "schema": "studyDocument",
      "description": "Core educational study documents and notes"
    }
  }
}
