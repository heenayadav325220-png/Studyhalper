{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "chats": {
          "$chatId": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || data.child('senderId').val() === auth.uid) && newData.child('senderId').val() === auth.uid",
            ".validate": "newData.hasChildren(['senderId', 'text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 3000"
          }
        },
        "whiteboard": {
          "$elementId": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || data.child('senderId').val() === auth.uid) && (newData.child('senderId').val() === auth.uid || !newData.exists())",
            ".validate": "newData.hasChildren(['senderId', 'type', 'points'])"
          }
        }
      }
    }
  }
}
